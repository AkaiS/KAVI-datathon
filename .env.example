# Copy to .env and fill in from Supabase dashboard -> Project Settings -> API Keys.

# Browser keys: scripts/dev.mjs copies only these two into config.js, which the browser downloads.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Secret key: bypasses RLS. For local Node scripts only (e.g. importing CSV data).
# Never copy it into config.js, index.html or any file the browser loads.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxx
