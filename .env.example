# Copy to .env and fill in from Supabase dashboard -> Project Settings -> API Keys.
# Only the publishable key goes here. Never put the secret / service_role key in this file:
# scripts/dev.mjs copies these values into config.js, which the browser downloads.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
