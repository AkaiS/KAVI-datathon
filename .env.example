# Copy to .env: cp .env.example .env
# Values come from Supabase dashboard -> Project Settings -> API Keys (KAVI organization).

# Browser keys, filled in for the team's project. Safe to commit: the publishable key can only read
# public.resources (RLS), and scripts/web/dev.mjs copies only these two into config.js for the browser.
SUPABASE_URL=https://xwpuphhocwstfgbjreeg.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_mwAVRHD_00cNdhNA9BKFSQ_QhrEtVDK

# Secret key: bypasses RLS. For local Node scripts only (e.g. importing CSV data).
# Never copy it into config.js, index.html or any file the browser loads.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxx
